<section class="td-sheet td-item-form">
  <header class="td-head"><div class="td-kicker">ARQUIVO / SUPRIMENTOS</div><div class="td-stamp">TERRA <span>DEVASTADA</span></div></header>
  <main class="td-paper"><label>IDENTIFICAÇÃO<input name="name" value="{{item.name}}"/></label><label>CATEGORIA<select name="system.categoria"><option value="arma" {{#if (eq system.categoria "arma")}}selected{{/if}}>Arma</option><option value="protecao" {{#if (eq system.categoria "protecao")}}selected{{/if}}>Proteção</option><option value="medicamento" {{#if (eq system.categoria "medicamento")}}selected{{/if}}>Medicamento</option><option value="municao" {{#if (eq system.categoria "municao")}}selected{{/if}}>Munição</option><option value="alimento" {{#if (eq system.categoria "alimento")}}selected{{/if}}>Alimento</option><option value="ferramenta" {{#if (eq system.categoria "ferramenta")}}selected{{/if}}>Ferramenta</option><option value="outro" {{#if (eq system.categoria "outro")}}selected{{/if}}>Outro</option></select></label>
    <div class="td-item-numbers"><label>QUANTIDADE<input type="number" min="0" name="system.quantidade" value="{{system.quantidade}}" /></label><label>MUNIÇÃO ATUAL<input type="number" min="0" name="system.municao" value="{{system.municao}}" /></label><label>CAPACIDADE<input type="number" min="0" name="system.capacidade" value="{{system.capacidade}}" /></label></div><label class="td-checkbox"><input type="checkbox" name="system.equipado" {{#if system.equipado}}checked{{/if}} /> Equipado / em uso</label><label>CONDIÇÃO QUE PODE JUSTIFICAR<input name="system.condicao" value="{{system.condicao}}" placeholder="Ex.: Armado com espingarda" /></label><label>DESCRIÇÃO<textarea rows="5" name="system.descricao">{{system.descricao}}</textarea></label><label>NOTAS<textarea rows="3" name="system.notas">{{system.notas}}</textarea></label></main>
  <footer class="td-footer">O VALOR DAS COISAS É DITADO PELA SOBREVIVÊNCIA</footer>
</section>
